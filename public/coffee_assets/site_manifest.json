  "core_brewing_parameters": {
    "water_temperature_celsius": 90,
    "coffee_grounds_grams": 10,
    "yield_ml": 180,
    "ratio": "1:18",
    "grind_setting": "3.5 (小富士/小飛馬標準，粗砂糖顆粒)",
    "core_principles": [
      "給水量不可大於咖啡顆粒所能吸收的極限",
      "良好過濾層的建立（水位下降至中心即將成凹狀即為最佳給水時機）",
      "漸進墊高水位，避免細粉沉積於濾杯底部形成死層造成堵塞"
    ]
  },
